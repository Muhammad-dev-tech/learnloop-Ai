# =====================================================================
# LearnLoop AI — Environment Configuration Template (.env.example)
# Copy this file to .env in your root directory and fill in your values.
# NEVER commit your actual .env file with secrets to version control.
# =====================================================================

# Application Settings
PROJECT_NAME="LearnLoop AI"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication (Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY="muhammadrabiulawan1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# SQLite (Default for zero-blocker local development):
DATABASE_URL="sqlite+aiosqlite:///./learnloop.db"
# PostgreSQL (Optional production format):
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/learnloop"

# Google Gemini AI Provider Configuration
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Document Storage & Upload Limits
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=25

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
